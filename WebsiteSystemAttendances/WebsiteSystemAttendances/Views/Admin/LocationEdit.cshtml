@model Newtonsoft.Json.Linq.JObject
@{ 
    ViewData["Title"] = "Edit Lokasi";
    string lat = Model?["latitude"]?.ToString() ?? "";
    string lng = Model?["longitude"]?.ToString() ?? "";
}

<div style="max-width:500px;">
    <div class="form-card">
        <h3 style="margin-bottom:1.5rem;font-size:1rem;"><i class="fas fa-edit" style="color:#ea580c;"></i> Edit Lokasi Kantor</h3>
        <form method="post" asp-controller="Admin" asp-action="LocationSave">
            <div class="form-group">
                <label>Nama Lokasi *</label>
                <input type="text" class="form-control" name="name" required value="@(Model?["name"] ?? "")" placeholder="Contoh: Kantor Pusat" />
            </div>
            <div class="form-group">
                <label>Alamat</label>
                <textarea class="form-control" name="address" rows="2" placeholder="Alamat lengkap lokasi kantor">@(Model?["address"] ?? "")</textarea>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <div class="form-group">
                    <label>Latitude *</label>
                    <input type="number" step="any" class="form-control" name="latitude" required value="@lat" placeholder="-6.2088" />
                </div>
                <div class="form-group">
                    <label>Longitude *</label>
                    <input type="number" step="any" class="form-control" name="longitude" required value="@lng" placeholder="106.8456" />
                </div>
            </div>
            <div class="form-group">
                <label>Radius Geofencing (meter) *</label>
                <input type="number" class="form-control" name="radiusMeters" required value="@(Model?["radiusMeters"] ?? 50)" />
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1.5rem;">
                <button type="submit" class="btn btn-primary" style="flex:1;padding:12px;"><i class="fas fa-save"></i> Perbarui Lokasi</button>
                <a asp-controller="Admin" asp-action="Locations" class="btn btn-outline" style="padding:12px;"><i class="fas fa-arrow-left"></i> Batal</a>
            </div>
        </form>
    </div>
</div>
