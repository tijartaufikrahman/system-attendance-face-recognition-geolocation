@{
    ViewData["Title"] = "Daftarkan Klien Baru";
}

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:1.5rem;">
    <!-- Form -->
    <div class="form-card">
        <h3 style="margin-bottom:1rem; font-size:1rem;"><i class="fas fa-building" style="color:#7c3aed;"></i> Data Perusahaan</h3>
        <form method="post" asp-controller="SuperAdmin" asp-action="CompanyCreate">
            <div class="form-group">
                <label>Nama Perusahaan *</label>
                <input type="text" class="form-control" name="name" required placeholder="PT. Maju Jaya" />
            </div>
            <div class="form-group">
                <label>Telepon</label>
                <input type="text" class="form-control" name="phone" placeholder="08123456789" />
            </div>
            <div class="form-group">
                <label>Alamat</label>
                <textarea class="form-control" name="address" rows="2" placeholder="Jl. Sudirman No. 123"></textarea>
            </div>

            <hr style="margin:1.5rem 0; border-color:#f1f5f9;" />
            <h3 style="margin-bottom:1rem; font-size:1rem;"><i class="fas fa-user-tie" style="color:#059669;"></i> Akun Admin HR Pertama</h3>

            <div class="form-group">
                <label>Nama Admin *</label>
                <input type="text" class="form-control" name="adminName" required placeholder="Budi Santoso" />
            </div>
            <div class="form-group">
                <label>Email Admin *</label>
                <input type="email" class="form-control" name="adminEmail" required placeholder="admin@majujaya.com" />
            </div>
            <div class="form-group">
                <label>Password Admin *</label>
                <input type="password" class="form-control" name="adminPassword" required minlength="6" placeholder="Minimal 6 karakter" />
            </div>

            <div style="display:flex; gap:0.5rem; margin-top:1.5rem;">
                <button type="submit" class="btn btn-primary" style="flex:1; padding:12px;">
                    <i class="fas fa-save"></i> Simpan & Buat Akun
                </button>
                <a asp-controller="SuperAdmin" asp-action="Companies" class="btn btn-outline" style="padding:12px;">
                    <i class="fas fa-arrow-left"></i> Batal
                </a>
            </div>
        </form>
    </div>

    <!-- Info -->
    <div>
        <div class="form-card" style="margin-bottom:1rem;">
            <h3 style="margin-bottom:1rem; font-size:1rem;"><i class="fas fa-info-circle" style="color:#3b82f6;"></i> Yang Akan Dibuat</h3>
            <div style="display:flex; flex-direction:column; gap:0.8rem;">
                <div style="display:flex; align-items:center; gap:10px; font-size:0.85rem;">
                    <i class="fas fa-check-circle" style="color:#059669;"></i> <strong>Perusahaan baru</strong> dengan data yang diisi
                </div>
                <div style="display:flex; align-items:center; gap:10px; font-size:0.85rem;">
                    <i class="fas fa-check-circle" style="color:#059669;"></i> <strong>Company Settings</strong> default (radius 50m, face tolerance 0.45)
                </div>
                <div style="display:flex; align-items:center; gap:10px; font-size:0.85rem;">
                    <i class="fas fa-check-circle" style="color:#059669;"></i> <strong>Role "Admin HR"</strong> untuk perusahaan
                </div>
                <div style="display:flex; align-items:center; gap:10px; font-size:0.85rem;">
                    <i class="fas fa-check-circle" style="color:#059669;"></i> <strong>Akun Admin HR</strong> yang bisa login ke portal
                </div>
            </div>
        </div>
        <div class="form-card">
            <h3 style="margin-bottom:0.5rem; font-size:1rem;"><i class="fas fa-lightbulb" style="color:#f59e0b;"></i> Tips</h3>
            <p style="font-size:0.8rem; color:#6b7280; line-height:1.6;">
                Setelah membuat perusahaan, akun Admin HR bisa langsung login di tab <strong>"Perusahaan"</strong> menggunakan email & password yang dibuat. Admin HR dapat mengelola master data, karyawan, dan absensi.
            </p>
        </div>
    </div>
</div>
